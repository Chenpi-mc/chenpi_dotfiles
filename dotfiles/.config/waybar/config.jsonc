{
    // waybar_chenpi 独立配置
    // 参考：brunoanesio/waybar-config（双时钟+calendar+mpris+notification）
    //       用户现有配置（niri/workspaces + group/audio + group/network-bluetooth + powermenu）
    // 设计：少实时显示，多 group。不依赖自定义脚本，换目录依然稳定。
    "layer": "top",
    "position": "top",
    "fixed-center": true,
    "reload_style_on_change": true,

    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],
    "modules-center": [
        "power-profiles-daemon",
        "idle_inhibitor",
        "clock",
        "custom/media-prev",
        "custom/media-playpause",
        "custom/media-next"
    ],
    "modules-right": [
        "tray",
        "group/backlight",
        "group/audio",
        "network",
        "bluetooth",
        "battery",
        "custom/powermenu_1"
    ],

    // ---------- niri ----------
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "󰜋",
            "default": ""
        }
    },
    "niri/window": {
        "format": "{}",
        "rewrite": {
            "(.*) - Mozilla Firefox": "🌎 $1"
        },
        "max-length": 40
    },

    // ---------- 时钟（时间 + 日期合并，tooltip 日历） ----------
    "clock": {
        "format": "󰥔 {:%H:%M %m月%d日 %a}",
        "interval": 60,
        "calendar": {
            "format": {
                "days": "<span weight='normal'>{}</span>",
                "months": "<span color='#dcc66e'><b>{}</b></span>",
                "today": "<span color='#ffb4ab' weight='700'><u>{}</u></span>",
                "weekdays": "<span color='#d2c6a1'><b>{}</b></span>",
                "weeks": "<span color='#aad0b2'><b>W{}</b></span>"
            },
            "mode": "month",
            "mode-mon-col": 1,
            "on-scroll": 1
        },
        "tooltip-format": "{calendar}\n---\n左键：时钟 (gnome-clocks)\n右键：日历 (gnome-calendar)",
        "on-click": "gnome-clocks",
        "on-click-right": "gnome-calendar"
    },


    // ---------- 网络（独立模块，放在电池左边） ----------
    "network": {
        "format-disconnected": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "{icon}",
        "format-icons": {
            "disconnected": "󰤮",
            "wifi": [
                "󰤯",
                "󰤟",
                "󰤢",
                "󰤥",
                "󰤨"
            ],
            "ethernet": "󰈀"
        },
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname} : {ipaddr}\n---\n左键：打开面板\n右键：高级网络配置",
        "tooltip-format-ethernet": "{ifname} : {ipaddr}\n---\n左键：打开面板\n右键：高级网络配置",
        "tooltip-format-disconnected": "网络未连接\n---\n左键：打开面板\n右键：高级网络配置",
        "on-click": "kitty --class network-tui -e ~/.config/waybar/scripts/select-network-tui.sh",
        "on-click-right": "kitty --class nmtui --title nmtui nmtui",
    },
    // ---------- 蓝牙（独立模块） ----------
    "bluetooth": {
        "format-disabled": "󰂲",
        "tooltip-format-disabled": "右键：启用蓝牙",
        "format": "󰂯",
        "tooltip-format-on": "左键：打开面板\n右键：禁用蓝牙",
        "format-connected": "󰂱",
        "tooltip-format-connected": "󰂱 {device_alias}\n---\n左键：打开面板",
        "on-click-right": "~/.config/waybar/scripts/toggle-bluetooth.sh",
        "on-click": "kitty --class bluetui -e bluetui"
    },

    // ---------- 亮度 group：预设按钮 + 内屏图标 + 滑条（hover 展开） ----------
    "group/backlight": {
        "orientation": "inherit",
        "drawer": {
            "transition-left-to-right": false
        },
        "modules": [
            "custom/ddcutil-day",
            "backlight/slider",
            "backlight",
            "custom/ddcutil-sleep",
            "custom/ddcutil-night"
        ]
    },
    "custom/ddcutil-day": {
        "tooltip-format": "左键：100% 亮度（外接屏+内屏）\\n右键：切换护眼模式",
        "format": "󰃠",
        "on-click": "ddcutil --display 1 setvcp 10 100 && brightnessctl set 100%",
        "on-click-right": "~/.local/bin/toggle-wlsunset"
    },
    "custom/ddcutil-night": {
        "tooltip-format": "左键：65% 亮度（外接屏+内屏）",
        "format": "󰃟",
        "on-click": "ddcutil --display 1 setvcp 10 65 && brightnessctl set 65%"
    },
    "custom/ddcutil-sleep": {
        "tooltip-format": "左键：5% 亮度（外接屏+内屏）",
        "format": "󰃞",
        "on-click": "ddcutil --display 1 setvcp 10 5 && brightnessctl set 5%"
    },
    "backlight/slider": {
        "min": 5,
        "max": 100,
        "orientation": "horizontal"
    },
    "backlight": {
        "tooltip": true,
        "tooltip-format": "调节内屏亮度",
        "format": "{icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            ""
        ],
        "on-scroll-up": "brightnessctl s +5%",
        "on-scroll-down": "brightnessctl s 5%-"
    },

    // ---------- 音频（group/audio：音量 + 滑条，hover 展开） ----------
    "group/audio": {
        "orientation": "inherit",
        "drawer": {
            "transition-left-to-right": false
        },
        "modules": [
            "custom/audio",
            "custom/mic",
            "pulseaudio/slider"
        ]
    },
    "custom/audio": {
        "exec": "/home/chenpi/.config/waybar/scripts/audio-sink.sh",
        "interval": 2,
        "return-type": "json",
        "format": "{}",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume --limit 1.53 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume --limit 1.53 @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "custom/mic": {
        "exec": "~/.config/waybar/scripts/mic.sh",
        "tooltip-format": "麦克风\n---\n左键：静音切换\n滚动：调节麦克风音量",
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-scroll-up": "wpctl set-volume --limit 1.00 @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume --limit 1.00 @DEFAULT_AUDIO_SOURCE@ 5%-",
        "interval": 2
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    // ---------- group：系统（CPU/内存，hover 展开，平时只占一个图标位） ----------
    // ---------- 托盘 ----------
    "tray": {
        "icon-size": 20,
        "spacing": 7,
        "show-passive-items": true
    },

    // ---------- 电池 ----------
    "battery": {
        "interval": 60,
        "states": {
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂂",
            "󰁹"
        ],
        "tooltip-format": "剩余电量：{capacity}%\n充 放 电 ：{power}\n可用时间：{timeTo}\n---\n电池健康度：{health}%"
    },

    // ---------- 性能模式 ----------
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "当前性能模式：{profile}\n---\n左键：切换性能模式",
        "tooltip": true,
        "format-icons": {
            "performance": "󱐋",
            "balanced": "",
            "power-saver": ""
        }
    },

    // ---------- 防熄屏 ----------
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        },
        "start-activated": true,
        "tooltip-format-activated": "自动熄屏已禁止",
        "tooltip-format-deactivated": "自动熄屏已开启"
    },

    // ---------- 性能 + 防熄屏：独立模块，CSS 合成盒子（不用 group） ----------

    // ---------- 音频控制（上一首/播放暂停/下一首，独立模块，CSS 合成盒子） ----------
    "custom/media-prev": {
        "format": "󰒮",
        "tooltip-format": "上一首",
        "on-click": "playerctl previous",
        "interval": 30
    },
    "custom/media-playpause": {
        "exec": "~/.config/waybar/scripts/media-playpause.sh",
        "tooltip-format": "播放 / 暂停",
        "on-click": "playerctl play-pause",
        "interval": 1
    },
    "custom/media-next": {
        "format": "󰒭",
        "tooltip-format": "下一首",
        "on-click": "playerctl next",
        "interval": 30
    },

    // ---------- 电源（单按钮，参考 waybar.old 的 custom/powermenu_1） ----------
    "custom/powermenu_1": {
        "tooltip-format": "左键点击显示电源菜单",
        "format": "󰐥",
        "on-click": "bash ~/.config/niri/scripts/powermenu"
    }
}
