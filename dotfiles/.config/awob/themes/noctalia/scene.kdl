// Noctalia 风格 OSD 主题
// 底部胶囊：上下留白14px 左右留白20px，左图标+文字 / 中进度条 / 右百分数
// 输入法事件（ime）时隐藏进度条和百分数
surface {
    width 400
    height 50
    anchor "bottom"
    offset 0 -10
    fade-in  "160ms"
    show     "1400ms"
    fade-out "220ms"
    transition "320ms"
}

palette {
    bg      "rgba(46,46,50,0.9)"
    fg      "#f2f2f2"
    track   "rgba(255,255,255,0.12)"
    accent  "#d8d0f0"
    muted   "rgba(242,242,242,0.55)"
    hidden  "#00000000"
}

styles {
    style "muted"    accent="$muted" alpha="0.85"
    style "warn"     accent="#e8c877"
    style "critical" accent="#e87070"
}

scene {
    rect z=0 x=0 y=0 width="100%" height="100%" radius=999 fill="$bg" shadow="0 8 22 rgba(0,0,0,0.35)"
    image z=1 src="{$icon ?? icon($event)}" x=20 y="center" width=20 height=20 colour="$fg"
    text z=1 value="{truncate($app ?? label($event), 15)}" font="JetBrainsMonoNL Nerd Font Propo 13 600" x=50 y=18 colour="$fg"
    rect z=1 x=200 y=23 width="100%-260" height=4 radius=999 fill="{ $event == 'ime' ? '#00000000' : '$track' }"
    bar z=2 x=200 y=23 width="100%-260" height=4 radius=999 fill="{ $event == 'ime' ? '#00000000' : '$accent' }" min=0 max="$max" value="$value" from="{$lastValue ?? $value}"
    text z=1 anchor="top-right" value="{ $event == 'ime' ? '' : int($progress * 100) + '%' }" font="JetBrainsMonoNL Nerd Font Propo 13 600" x=20 y=18 colour="$muted"
}
